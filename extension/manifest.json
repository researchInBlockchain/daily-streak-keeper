{
  "manifest_version": 3,
  "name": "Daily Streak Keeper for LeetCode",
  "short_name": "Streak Keeper",
  "version": "1.0.0",
  "description": "Keeps your daily streak: finds a working solution to the problem of the day, checks it on the examples and submits it.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Daily Streak Keeper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "ui/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["alarms", "storage", "notifications", "scripting", "cookies", "idle"],
  "host_permissions": ["https://leetcode.com/*", "https://cdn.jsdelivr.net/*"],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*"
  ]
}
