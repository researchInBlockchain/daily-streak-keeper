{
  "manifest_version": 3,
  "name": "LeetCode Daily Agent - cookie sync",
  "version": "1.0",
  "description": "Keeps the LeetCode Daily Agent's login fresh by passing your leetcode.com session cookie to it on this computer.",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "alarms"],
  "host_permissions": ["https://leetcode.com/*"],
  "background": { "service_worker": "background.js" }
}
